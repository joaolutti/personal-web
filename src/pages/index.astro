---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Card from '../components/Card.astro';
import { categories, getIconPath, icons, stack } from '../data/stack';
import RowEntry from '../components/RowEntry.astro';
import CopyEmail from '../components/CopyEmail.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import ParticleCanvas from '../components/ParticleCanvas.astro';

const email = 'joaolutti@hello.com';

const projects = await getCollection('projects');
const featured = projects.filter((proj) => proj.data.featured);
---

<BaseLayout>
    <section id="hero" class="hero">
        <div class="canvas">
            <ParticleCanvas />
        </div>
        <h1>joão lutti <span class="blink"></span></h1>
        <p class="bio">
            I build fast, considered web products from the database to the last pixel. Recent SWE
            graduate from the University of Calgary who cares about latency, typography, and the
            small details that make software feel calm.
        </p>
        <div class="socials">
            <a href="https://github.com/joaolutti" target="_blank">github ↗</a>
            <a href="https://www.linkedin.com/in/joaoglutti">linkedin ↗</a>
            <a href="#cta">email ↓</a>
        </div>
    </section>

    <section id="work">
        <SectionTitle section="selected work" />
        {
            featured.map((proj) => (
                <>
                    <Card project={proj} />
                </>
            ))
        }
        <div class="projects-cta">
            <a href="#">all work in detail →</a>
        </div>
    </section>

    <section id="stack">
        <SectionTitle section="stack" />
        <div class="skills-grid">
            {
                categories.map((category) => {
                    const categorySkills = stack.filter((stack) => stack.category === category);
                    return (
                        <article class="skill-col">
                            <h2>{category}</h2>
                            <ul class="skill-list">
                                {categorySkills.map((skill) => (
                                    <li class="skill">
                                        <span
                                            class="skill__icon"
                                            style={`
                                                --icon-url: url("${getIconPath(skill.icon)}");
                                                --icon-color: ${icons[skill.icon].color};
                                                `}
                                        />
                                        <span>{skill.name}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    );
                })
            }
        </div>
    </section>
    <section id="currently-doing">
        <SectionTitle section="currently" text="updated monthly" />
        <RowEntry action="reading" item="Annihilation" comment="Jeff Vandermeer" />
        <RowEntry
            action="listening"
            item="The Mountain by Gorillaz"
            comment="on loop while doing pretty much anything"
        />
        <RowEntry action="playing" item="World of Warcraft" comment="zug zug" />
    </section>
    <section id="cta">
        <SectionTitle section="contact" />
        <h3>up for a coffee chat? let's talk.</h3>
        <article class="cta-row">
            <CopyEmail email={email} resetAfter={2000} />
            <a href="https://github.com/joaolutti">github ↗</a>
            <a href="https://www.linkedin.com/in/joaoglutti">linkedin ↗</a>
        </article>
    </section>
    <Footer />
</BaseLayout>

<style>
    section {
        padding: 0px 0px 96px;
    }
    .canvas {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        height: 380 px;
        background: radial-gradient(120% 90% at 50% 40%, var(--hover), transparent 70%);
    }

    .blink {
        display: inline-block;
        width: 0.3em;
        height: 0.92em;
        background: var(--text);
        margin-left: 0.12em;
        animation: blink-cursor 1.1s steps(1) infinite;
        border-radius: 1px;
    }

    @keyframes blink-cursor {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }

    .bio {
        font-size: 20px;
        line-height: 1.5;
        color: var(--muted);
        text-wrap: pretty;
    }
    #hero h1 {
        display: flex;
        color: var(--text);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.05;
        font-size: clamp(2.5rem, 6vw, 4rem);
        flex-wrap: wrap;
        margin-top: 80px;
    }

    .hero {
        padding: 56px 0 90px;
        scroll-margin-top: 80px;
    }

    .socials {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;

        a {
            font-family: var(--font-mono);
            font-size: 14px;
            color: var(--muted);
            border-bottom: 1px solid transparent;
            text-decoration: none;

            &:hover {
                color: var(--text);
                border-bottom: 1px solid var(--border-strong);
            }
        }
    }

    #work {
        scroll-margin-top: 80px;
    }

    .projects-cta {
        margin-top: 32px;
    }
    .projects-cta a {
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--muted);
        text-decoration: none;
    }
    .projects-cta a:hover {
        color: var(--text);
    }

    /* #stack {
        padding: 0 0 96px;
    } */
    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
    }

    .skill-list {
        display: grid;
        gap: 0.75rem;
        padding: 0;
        list-style: none;
    }

    .skill-col {
        color: var(--text2);
        font-size: 15px;

        h2 {
            font-family: var(--font-mono);
            font-size: 11.5px;
            color: var(--faint);
            margin-bottom: 16px;
        }
    }

    .skill {
        display: flex;
        font-family: var(--font-sans);
        align-items: center;
        gap: 10px;
    }

    .skill__icon {
        display: inline-block;
        width: 17px;
        height: 17px;
        background-color: var(--icon-color);
        mask: var(--icon-url) center / contain no-repeat;
        flex-shrink: 0;
    }

    #cta {
        padding: 0 0 40px;
        h3 {
            font-size: clamp(1.5rem, 4vw, 2.5rem);
            line-height: 1.1;
            font-weight: 500;
            margin: 0 0 26px;
            max-width: 25ch;
            text-wrap: balance;
            color: var(--text);
        }
        a {
            font-family: var(--font-mono);
            font-size: 14px;
            text-decoration: none;
            color: var(--muted);
            padding: 12px 4px;
            border-bottom: 1px solid transparent;
            &:hover {
                color: var(--text);
            }
        }
    }

    .cta-row {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
</style>
