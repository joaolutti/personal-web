---
interface Props {
    section: string;
    text?: string;
    marginBottom?: string;
}


const { section, text, marginBottom = '32px' } = Astro.props;
---

<div class="title" style={`--sec-margin-bottom: ${marginBottom}`}>
    <h1>
        {section}
    </h1>
    <p>{text}</p>
</div>

<style>
    .title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: var(--sec-margin-bottom);
    }

    h1 {
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.05em;
        color: var(--muted);
        font-weight: 500;
        margin: 0;
    }

    p {
        font-family: var(--font-mono);
        color: var(--faint);
        font-size: 11px;
        margin-left: auto;
    }
</style>
