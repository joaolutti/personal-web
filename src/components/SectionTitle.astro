---
const {section, text} = Astro.props
---

<div class="title">
    <h1>
        {section}
    </h1>
    <p>{text}</p>
</div>

<style>
    .title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 32px;
    }

    h1 {
        font-family: var(--font-mono);
        font-size: 12.5px;
        letter-spacing: 0.05em;
        color: var(--muted);
        font-weight: 500;
        margin: 0;
    }

    p {
        font-family: var(--font-mono);
        color: var(--faint);
        font-size: 11px;
        margin-left: auto;
    }
</style>