---
const pathname = Astro.url.pathname;

const isRouteActive = (route: string) => {
    return pathname === route || pathname.startsWith(`${route}/`);
};

const projectsActive = isRouteActive('/projects');
const writingActive = isRouteActive('/writing');

const isHome = pathname === '/';
---

<nav>
    <a class="logo" href="/"> joão lutti </a>
    {
        isHome && (
            <div class="nav-links">
                <a href="#work">work</a>
                <a href="/projects">projects</a>
                <a href="/writing">writing</a>
                <a href="filefortest.pdf">resume</a>
                <button>theme</button>
            </div>
        )
    }
    {
        projectsActive && (
            <div class="nav-links">
                <a href="/writing">writing</a>
                <a href="/">← back</a>
                <button>theme</button>
            </div>
        )
    }
    {
        writingActive && (
            <div class="nav-links">
                <a href="/projects">projects</a>
                <a href="/">← back</a>
                <button>theme</button>
            </div>
        )
    }
</nav>

<style>
    nav {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 var(--page-padding-x);
        height: var(--nav-height);
    }

    a {
        text-decoration: none;
    }

    .logo {
        font-weight: 600;
        color: var(--text);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 24px;
        a {
            color: var(--muted);
            font-size: 14px;
        }
        a:hover {
            color: var(--text);
        }

        a[href$='.pdf'] {
            font-family: var(--font-mono);
            font-size: 12px;
            padding: 7px 13px;
            border: 1px solid var(--border-strong);
            border-radius: 8px;
            color: var(--text);
        }

        a[href$='.pdf']:hover {
            background: var(--text);
            color: var(--bg);
            border-color: var(--text);
        }
    }

    button {
        display: inline-flex;
        align-items: center;
    }
</style>
