---
const currentYear = new Date().getFullYear();
---

<div class="footer">
    <h1>© {currentYear} joão lutti</h1>
    <h1>built with astro.js, by yours truly</h1>
</div>

<style>
    .footer {
        display: flex;
        border-top: 1px solid var(--border);
        padding: 15px 0 60px;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    h1 {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--faint);
    }
</style>
