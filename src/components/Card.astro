---
import { render, type CollectionEntry } from "astro:content";
interface Props {
    project: CollectionEntry<'projects'>
}

const { project } = Astro.props;
const stackArray = project.data.stack;
---

<article id={project.id} class="card">
    <a href=`/projects#${project.id}`>
        <div class="upper-row">
            <div class="project-title">
                <h2>
                    {project.data.title}
                </h2>
            </div>
            <h3>{project.data.year}</h3>
        </div>
        <div class="bottom-row">
            <div class="body">
                <p>{project.data.brief}</p>
                <span class="stack-item">
                    {
                        stackArray.map((entry, i) => (
                            <>
                                <span>{entry}</span>
                                {i < stackArray.length - 1 && <span> • </span>}
                            </>
                        ))
                    }
                </span>
            </div>
        </div>
    </a>
</article>

<style>
    .card {
        display: block;
        border-top: 1px solid var(--border);
        padding: 26px 8px 26px 0;
        transition:
            padding-left 0.25s ease,
            background 0.25s ease;
    }

    a {
        text-decoration: none;
    }

    .card:hover {
        padding-left: 14px;
        background: var(--hover);
    }

    .upper-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
    }

    .project-title {
        display: flex;
        align-items: baseline;
        min-width: 0;
    }

    h2::before {
        content: '↳ ';
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--faint);
        margin-right: 14px;
    }

    h2 {
        font-size: 22px;
        font-weight: 500;
        color: var(--text);
    }

    .body {
        padding-left: 28px;
        font-size: 16px;
        color: var(--muted);
        margin: 0 0 10px;
        text-wrap: pretty;
    }

    h3 {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--faint);
        white-space: nowrap;
    }

    .stack-item {
        color: var(--faint);
        font-size: 12px;
        font-family: var(--font-mono);
    }
</style>
